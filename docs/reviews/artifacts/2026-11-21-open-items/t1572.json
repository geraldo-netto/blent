  "ownership": {
    "rotation_source": "one application-owned default-display observer, registered on main Handler; never retains Activity; stop fences delivery before unregister and retains original registration identity if unregister throws",
    "camera": "bounded desired angle snapshot belongs to one generation; existing ResourceLane owns one current run and latest pending replacement, and original MediaConsumerClaim retirement remains unchanged",
    "cutoff": "duplicate/invalid rotations and inactive cameras do not start workers; explicit permission/background policy rechecked; shutdown cancels replacement and unregisters source; queued old callbacks are fenced",
    "cleanup_assumption": "Android DisplayManager unregister detaches that original registration; already queued callbacks retain their managed object until dispatched but cannot call retired binding through observer"
  },
  "limitations": [
    "No physical tablet orientation or host camera latency measurement",
    "Rotation briefly restarts camera; it is not a per-frame wire metadata update",
    "Robolectric framework delivery and fake Binder death are regression evidence, not unrestricted native safety proof"
  ]
