#!/bin/sh
# Each daemon invocation owns its runtime mount/extraction independently.
set -eu
configure_application_directory() {
    blent_entry=$(readlink -f -- "$0")
    blent_directory=${blent_entry%/*}
    if [ "$(readlink -f -- "${APPDIR:-}" 2>/dev/null || :)" != "$blent_directory" ]; then
        unset APPIMAGE
    fi
    APPDIR=$blent_directory
    export APPDIR
}
configure_application_directory
if [ -n "${APPIMAGE:-}" ] && [ -x "$APPIMAGE" ]; then
    BLENT_APPIMAGE_LAUNCHER=$APPIMAGE
else
    BLENT_APPIMAGE_LAUNCHER=$APPDIR/AppRun
fi
export BLENT_APPIMAGE_LAUNCHER
# Child invocations also work when the parent used the one-shot extraction flag.
export APPIMAGE_EXTRACT_AND_RUN=1
export PATH="$APPDIR/usr/bin:$PATH"
# ELF RUNPATHs supply private libraries without contaminating host utilities.
case "${1:-}" in
    '') exec "$APPDIR/usr/bin/blent-gui" ;;
    --gui) shift; exec "$APPDIR/usr/bin/blent-gui" "$@" ;;
    --install-user) shift; exec "$APPDIR/usr/bin/bash" "$APPDIR/usr/share/blent/install-appimage.sh" "$@" ;;
    --daemon) shift; exec "$APPDIR/usr/bin/blent" "$@" ;;
    *) exec "$APPDIR/usr/bin/blent" "$@" ;;
esac
