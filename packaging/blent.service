[Unit]
Description=Blent — Android tablet as a second display
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# T582: fair CPU preference for the complete capture/encode/helper group.
# The daemon applies the user's High/Normal preference at startup.
CPUWeight=1000
# T1465: the shared server belongs to an independent scope. Explicit loopback
# clients fail on server loss instead of spawning a server in this service.
Environment=ADB_SERVER_SOCKET=tcp:127.0.0.1:5037
ExecStartPre=/usr/bin/systemd-run --user --scope --quiet -- /usr/bin/blent --blent-start-adb-server
ExecStart=/usr/bin/blent start
# T1412: the daemon owns native child shutdown and exact cleanup settlement.
# A caller's response deadline must not kill that owner or its children.
KillMode=mixed
SendSIGKILL=no
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
