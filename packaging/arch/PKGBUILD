# Maintainer: Geraldo Netto (https://github.com/geraldo-netto)
# Original upstream author: majmichu1
pkgname=blent
pkgver=1.2.3
pkgrel=1
pkgdesc="Use an Android tablet as a USB second display and graphics tablet (KDE Wayland)"
arch=('x86_64')
url="https://github.com/geraldo-netto/blent"
license=('MIT' 'LGPL-2.1-or-later')
depends=('evdi-dkms' 'ffmpeg' 'android-tools' 'bash' 'coreutils' 'libusb' 'libx11' 'libxcursor' 'libxi' 'libxkbcommon-x11')
optdepends=('pipewire: microphone and speaker sharing')
makedepends=('pipewire' 'clang' 'cargo' 'gcc' 'pkgconf' 'libdrm')
install=blent.install
_evdi=2713cd41932f2bd8697953a205862a68a966b5ba
source=("$pkgname-$pkgver.tar.gz::https://github.com/geraldo-netto/blent/archive/refs/tags/v$pkgver.tar.gz"
        "evdi-$_evdi.tar.gz::https://codeload.github.com/DisplayLink/evdi/tar.gz/$_evdi")
# Release template: build-packages.sh hashes the published Blent tag archive.
sha256sums=('@BLENT_SOURCE_SHA256@' 'f4f293c26ccce1b52a8534228c5748c8c17b5c2f3b1d4e5a6139b0a066ea098d')

build() {
  cd "blent-$pkgver"
  cargo build --release --locked --target-dir target --manifest-path host/Cargo.toml --features native-audio,accessory-transport
  cargo build --release --locked --target-dir target --manifest-path gui/Cargo.toml
  make --always-make -C host/accessory OUTPUT=../../target/release/blent-usb-io
  # libevdi built from upstream and shipped next to the helper (rpath $ORIGIN),
  # so the only thing the system must provide is the evdi kernel module.
  make -C "$srcdir/evdi-$_evdi/library"
  EVDI_LIBRARY_DIR="$srcdir/evdi-$_evdi/library" make --always-make -C host/evdi
}

package() {
  cd "blent-$pkgver"
  install -Dm755 scripts/setup-system.sh "$pkgdir/usr/share/blent/setup-system.sh"
  install -Dm644 packaging/blent-evdi.conf "$pkgdir/usr/share/blent/setup/blent-evdi.conf"
  install -Dm644 packaging/blent-modules.conf "$pkgdir/usr/share/blent/setup/blent-modules.conf"
  install -Dm644 packaging/60-blent-uinput.rules "$pkgdir/usr/share/blent/setup/60-blent-uinput.rules"
  install -Dm755 scripts/gpu-boot-order.sh "$pkgdir/usr/share/blent/gpu-boot-order.sh"
  install -Dm755 scripts/setup-evdi.sh "$pkgdir/usr/share/blent/setup-evdi.sh"
  install -Dm755 target/release/blent     "$pkgdir/usr/bin/blent"
  install -Dm755 target/release/blent-gui "$pkgdir/usr/bin/blent-gui"
  install -Dm755 target/release/blent-audio "$pkgdir/usr/bin/blent-audio"
  install -Dm755 target/release/blent-usb-broker "$pkgdir/usr/bin/blent-usb-broker"
  install -Dm755 target/release/blent-usb-io "$pkgdir/usr/bin/blent-usb-io"
  install -Dm755 host/evdi/evdi_helper      "$pkgdir/usr/lib/blent/evdi_helper"
  install -Dm755 "$srcdir/evdi-$_evdi/library/libevdi.so.1.15.0" "$pkgdir/usr/lib/blent/libevdi.so.1.15.0"
  ln -sf libevdi.so.1.15.0 "$pkgdir/usr/lib/blent/libevdi.so.1"
  install -Dm644 scripts/blent.desktop    "$pkgdir/usr/share/applications/blent.desktop"
  install -Dm644 packaging/icons/blent.svg     "$pkgdir/usr/share/icons/hicolor/scalable/apps/blent.svg"
  install -Dm644 packaging/icons/blent-pen.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/blent-pen.svg"
  install -d "$pkgdir/usr/lib/systemd/user"
  bash scripts/write-systemd-service.sh /usr/bin/blent scripts/blent.service > "$pkgdir/usr/lib/systemd/user/blent.service"
  chmod 644 "$pkgdir/usr/lib/systemd/user/blent.service"
  install -Dm644 packaging/blent-evdi.conf "$pkgdir/usr/lib/modprobe.d/blent-evdi.conf"
  install -Dm644 packaging/blent-modules.conf "$pkgdir/usr/lib/modules-load.d/blent.conf"
  install -Dm644 packaging/60-blent-uinput.rules "$pkgdir/usr/lib/udev/rules.d/60-blent-uinput.rules"
  ./scripts/copy-distribution-docs.sh "$pkgdir/usr/share/doc/blent"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 licenses/libevdi-LGPL-2.1.txt "$pkgdir/usr/share/licenses/$pkgname/libevdi-LGPL-2.1.txt"
}
